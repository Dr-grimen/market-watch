# Kopier denne fila til .env og fyll inn dine eigne verdiar.
# .env er i .gitignore og blir ALDRI lasta opp til GitHub.

# Anthropic (Claude Haiku) - hent på https://console.anthropic.com
ANTHROPIC_API_KEY=

# Varslingskanal: telegram | twilio_sms | stdout
NOTIFIER=telegram

# --- Telegram (gratis) ---
# Snakk med @BotFather i Telegram -> /newbot -> du får eit token.
# Send så ei melding til din eigen bot, og hent chat_id frå
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio SMS (kostar pengar - berre om du byter tilbake) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=
