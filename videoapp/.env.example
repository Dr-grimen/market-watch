# Kopier til .env og fyll inn. .env skal ALDRI i git - sjaa .gitignore.
#
#   cp .env.example .env
#
# Lekk ein noekkel likevel: trekk han tilbake hos leverandoeren FOERST,
# lag ein ny, og gaa ut frae at den gamle er i bruk av andre. Aa fjerne
# han frae git-historikken er ikkje nok - han er allereie kopiert.

# --- maa vere sett, appen startar ikkje utan ---

# Lag med:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Byter du denne, blir ALLE innlogga brukarar logga ut. Det er meininga.
VIDEOAPP_TOKEN_NOKKEL=

# Eigen noekkel for appen. Ikkje same som du brukar til noko anna -
# da kan du ikkje trekkje tilbake den eine utan aa drepe den andre,
# og du ser ikkje kva appen faktisk kostar.
MINIMAX_API_NOKKEL=

# Til promptforbetring og moderering.
ANTHROPIC_API_KEY=

# --- valfritt ---

SEEDANCE_API_NOKKEL=
RUNWAY_API_NOKKEL=

# Utan denne koeyrer alt paa SQLite, som er greitt i utvikling og
# feil i produksjon.
DATABASE_URL=

# Kva vassmerket skal seie.
VASSMERKE_TEKST=videoapp.no
